# Copy to deploy/.env and fill in. Never commit deploy/.env.

# TimescaleDB (used by compose and to build DATABASE_URL).
# Use a URL-safe password: letters, digits, - _ . ~
POSTGRES_USER=traderbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=traderbot

# Referenced from configs/config.yaml as ${VAR}. Add one line per secret you use.
TELEGRAM_TOKEN=123456:replace-with-your-bot-token
TELEGRAM_CHAT_ID=123456789
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace/me
